{
  "_about": "Per-object recipes for tools/models/build_models.py (3D model -> AnimatedSprite sheet). Each object is INERT until you drop a model at its `source` path (tools/models/source/ is gitignored). `design_width`/`design_height` = the object's CURRENT on-screen frame size in design px (so the render supersamples that, staying a drop-in); `supersample` = crispness multiplier (render px = design * supersample). `layout`: 'grid' = uniform cols x rows sheet for AlienDrawableGameComponent (mothership/UFO); 'atlas' = packed atlas + .dat for AnimatedSprite (spider). `mode`: 'hero' (one still) or 'turntable' (N rotation frames). See README.md.",

  "blender_exe": null,

  "objects": {
    "mothership": {
      "note": "The mothership boss hover animation (Boss.cs: LoadAnimation mothershipB 4x4 @16fps). A turntable's 16 rotation frames fill the 4x4 grid. To keep on-screen size after upscaling, add DesignFrameWidth[\"GFX/Sprites/mothershipB\"] = 456 in AlienDrawableGameComponent.cs. mothershipA is the plain first-half Texture2D companion; re-render/split it to match if you swap.",
      "source": "source/mothership.glb",
      "output": "../../web/EvilAliensWeb/wwwroot/Content/gfx/sprites/mothershipb_model",
      "texture_key": "GFX/Sprites/mothershipB",
      "layout": "grid",
      "mode": "turntable",
      "columns": 4,
      "rows": 4,
      "design_width": 456,
      "design_height": 456,
      "supersample": 2,
      "turntable_axis": "Z",
      "samples": 96,
      "camera": { "elevation_deg": 22, "azimuth_deg": 0, "fov_deg": 32, "margin": 1.2, "ortho": false },
      "light": { "key_energy": 4.5, "environment": 0.5 }
    },

    "bigufo": {
      "note": "TEMPLATE for the 'big UFO'. Point `texture_key`/`output`/`columns`/`rows`/`design_*` at whichever large saucer you mean (e.g. GFX/Sprites/ufosheet is the player saucer sheet, design width 48). This entry is a copy-me starting point; retarget it before dropping a model in.",
      "source": "source/bigufo.glb",
      "output": "../../web/EvilAliensWeb/wwwroot/Content/gfx/sprites/bigufo_model",
      "texture_key": "GFX/Sprites/ufosheet",
      "layout": "grid",
      "mode": "turntable",
      "columns": 4,
      "rows": 4,
      "design_width": 48,
      "design_height": 48,
      "supersample": 4,
      "turntable_axis": "Z",
      "samples": 64,
      "camera": { "elevation_deg": 18, "azimuth_deg": 0, "fov_deg": 35, "margin": 1.25, "ortho": false },
      "light": { "key_energy": 4.0, "environment": 0.5 }
    },

    "spiderboss": {
      "note": "The spider boss (SpiderBoss.cs) draws AnimatedSprites spiderfly/jump/land/stand. A single static model can't reproduce those gameplay animations, so this renders a fresh atlas 'spiderboss_model' (hero pose by default; set mode=turntable for a spin) that you wire into SpiderBoss.cs where you want it, constructing `new AnimatedSprite(\"GFX/Spider/spiderboss_model\", supersample: 3)`. design 640x480 matches the original spider frame size.",
      "source": "source/spiderboss.glb",
      "output": "../../web/EvilAliensWeb/wwwroot/Content/gfx/spider/spiderboss_model",
      "layout": "atlas",
      "anim_name": "spiderboss",
      "mode": "hero",
      "turntable_frames": 16,
      "design_width": 640,
      "design_height": 480,
      "supersample": 3,
      "turntable_axis": "Z",
      "samples": 96,
      "camera": { "elevation_deg": 12, "azimuth_deg": 0, "fov_deg": 34, "margin": 1.2, "ortho": false },
      "light": { "key_energy": 4.5, "environment": 0.5 }
    }
  }
}
